# Local development configuration (Ollama-backed decision endpoint).
# Load with: set -a; . ./env; set +a
export DECISION_API_KEY=test
export DECISION_MODEL=tev1:4b
export DECISION_ENDPOINT=http://localhost:11434/v1/systemone

# MCP server
export MCP_ALLOWED_HOSTS='*'
export MCP_BIND_ADDR=0.0.0.0:8080
export MCP_PATH=/mcp

# Upstream request timeout in seconds
export DECISION_TIMEOUT_SECS=120

export RUST_LOG=decision_mcp=info,tower_http=info
