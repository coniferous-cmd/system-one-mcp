# Required
SYSTEM_ONE_API_KEY=sk-or-v1-replace-me
SYSTEM_ONE_MODEL=typesafe/jev-1.13

# Full upstream endpoint. Defaults to https://system-one.dev/v1/systemone
SYSTEM_ONE_ENDPOINT=https://openrouter.ai/api/alpha/decisions

# MCP server
MCP_BIND_ADDR=0.0.0.0:8080
MCP_PATH=/mcp
# Streamable HTTP only accepts loopback Host headers by default.
# Set this to your public hostnames when deploying remotely.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Upstream request timeout in seconds (default 120)
SYSTEM_ONE_TIMEOUT_SECS=120
